            "url": "{{baseUrl}}/up",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "id"
              }
